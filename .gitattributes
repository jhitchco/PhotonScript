# Normalize line endings. Files are authored on Linux/cloud (LF) and edited on
# the Windows scope PC; without this, Git on Windows (core.autocrlf=true) warns
# "LF will be replaced by CRLF" and flip-flops endings. Store and check out LF
# everywhere so it stays consistent and the warnings stop.
* text=auto eol=lf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.fits binary
*.fit binary
*.xisf binary

# PS-171: real TheSky64 TPoint files, kept byte for byte (CRLF)
tests/test_scheduler/fixtures/tpoint/thesky64_* -text
